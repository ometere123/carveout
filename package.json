    "check:static": "npm run check:python && npm run check:contract-patterns && npm run check:release && npm run check:frontend-surface",
    "check:frontend-surface": "python scripts/check_frontend_surface.py"
  },
  "dependencies": {
    "genlayer-js": "^1.1.8"
  },
  "devDependencies": {
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
